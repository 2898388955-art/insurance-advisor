# 复制为 .env 后填写自己的值
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=insurance_advisor
MYSQL_USER=ia
MYSQL_PASSWORD=change-me

REDIS_PORT=6380
REDIS_ARGS=--appendonly yes

# 对象存储（S3 兼容，Milvus 使用）
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=change-me
S3_PORT=9000
S3_CONSOLE_PORT=9001

# Milvus
MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091

# 应用端口（Docker Compose 全栈模式）
SERVER_PORT=8080
AI_PORT=8000
WEB_PORT=8088

# AI 服务
# 本地 Ollama（容器内通过 host.docker.internal 访问宿主机）
OLLAMA_URL=http://host.docker.internal:11434
LLM_PROVIDER=openai
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_API_KEY 不要写进本文件，启动时从系统环境变量注入：
#   export DEEPSEEK_API_KEY=sk-xxx

